# Copia como .env y completa con los valores de Railway

# Users microservice — base de datos Railway
# Obtén esta URL desde Railway → Postgres → Variables → DATABASE_PUBLIC_URL
USERS_DATABASE_URL=postgresql://postgres:<PASSWORD>@maglev.proxy.rlwy.net:<PORT>/railway

# JWT (usa la misma clave en todos los servicios que validen tokens)
JWT_SECRET_KEY=cambia-esto-por-una-clave-segura
JWT_ACCESS_TOKEN_EXPIRE_HOURS=1
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
